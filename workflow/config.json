{
  "$comment": "BTC agent 项目的 workflow 配置。引擎(scripts/hooks/skills)随 ai-workflow plugin 发布；项目特定的一切都在此文件。{engine}/ 在 check args 中解析为 plugin scripts 目录。",
  "project_name": "BTC Agent",
  "memory": {
    "pointers": [
      "Agent rules: AGENTS.md",
      "Domain docs: docs/agents/domain.md",
      "Issue tracker: docs/agents/issue-tracker.md",
      "Workflow 协议: workflow/README.md | Lessons: workflow/context/lessons.md",
      "架构基座: TradingAgents(LangGraph 多 agent 辩论)改装，数据源换 crypto vendor，日历改 7×24 UTC",
      "调研与设计: BTC-AGENT-FEASIBILITY.md(可行性) / BEACON-FEATURE-REFERENCE.md(A股参照) / BTC-DESIGN-REVIEW.md(设计评估+v0→成熟路线)"
    ],
    "global_memory_dir": "C:/Users/admin/.agents/workflow-memory"
  },
  "codex_workflow": {
    "version": 1,
    "default_tier": "small",
    "default_class": "agent-change",
    "max_fix_loops": 2,
    "max_subagents": 2,
    "check_timeout_seconds": 900,
    "global_memory_dir": "C:/Users/admin/.agents/workflow-memory"
  },
  "python": {
    "venv": "btc_agent/.venv"
  },
  "components": {
    "agent": {
      "dir": "btc_agent",
      "type": "python-venv",
      "probe_imports": [
        "pytest",
        "ruff"
      ]
    }
  },
  "checks": {
    "agent": [
      {
        "name": "ruff",
        "dir": "btc_agent",
        "cmd": "python",
        "args": [
          "-m",
          "ruff",
          "check",
          "."
        ]
      },
      {
        "name": "pytest",
        "dir": "btc_agent",
        "cmd": "python",
        "args": [
          "-m",
          "pytest"
        ]
      }
    ]
  },
  "workflow_classes": {
    "agent-change": [
      "agent"
    ]
  },
  "auto_check": {
    "$comment": "PostToolUse 快速检查: 命中 path_contains + extension 的文件跑 ruff",
    "path_contains": "btc_agent",
    "extension": ".py",
    "cmd": "python",
    "args": [
      "-m",
      "ruff",
      "check"
    ]
  },
  "contract_touchpoints": {
    "$comment": "契约面 = vendor 路由 / agent 输出 schema / 机械价位入口 / 情报层规则+推送。改这些文件即视为触碰契约，structural_checks 断言核心不变式不被静默删除(v1 回填)。",
    "surface_markers": [
      "btc_agent/src/btc_agent/dataflows/interface.py",
      "btc_agent/src/btc_agent/agents/schemas.py",
      "btc_agent/src/btc_agent/run.py",
      "btc_agent/src/btc_agent/intel/",
      "btc_agent/src/btc_agent/evidence.py",
      "btc_agent/src/btc_agent/regime.py",
      "btc_agent/src/btc_agent/candidates.py",
      "btc_agent/src/btc_agent/ledger.py",
      "btc_agent/src/btc_agent/settlement.py",
      "btc_agent/src/btc_agent/decision_card.py",
      "btc_agent/src/btc_agent/daily.py",
      "btc_agent/src/btc_agent/settlement_math.py"
    ],
    "structural_checks": [
      {
        "file": "btc_agent/src/btc_agent/dataflows/interface.py",
        "must_contain": [
          "\"ccxt\": get_ccxt_data",
          "\"cryptorss\": get_crypto_rss_news",
          "DISABLED_METHODS = {"
        ],
        "error": "vendor 路由契约破损: crypto 行情(ccxt)/新闻(cryptorss)注册或 fundamentals 禁用被移除"
      },
      {
        "file": "btc_agent/src/btc_agent/agents/schemas.py",
        "must_contain": [
          "class ResearchPlan",
          "class TraderProposal",
          "class PortfolioDecision",
          "class CandidateVerdict"
        ],
        "error": "结构化输出 schema 契约破损: 缺 ResearchPlan/TraderProposal/PortfolioDecision/CandidateVerdict"
      },
      {
        "file": "btc_agent/src/btc_agent/run.py",
        "must_contain": [
          "compute_trade_levels",
          "mechanical (ATR-based), not LLM"
        ],
        "error": "机械价位契约破损: 交易价位必须机械算(不让 LLM 报买卖数字)"
      },
      {
        "file": "btc_agent/src/btc_agent/intel/rules.py",
        "must_contain": [
          "def evaluate"
        ],
        "error": "情报层规则引擎契约破损: evaluate 入口缺失"
      },
      {
        "file": "btc_agent/src/btc_agent/daily.py",
        "must_contain": [
          "compute_trade_levels",
          "blank_sheet"
        ],
        "error": "v2 每日编排契约破损: 机械价位不变式(compute_trade_levels)或白卷开关(blank_sheet)被移除"
      },
      {
        "file": "btc_agent/src/btc_agent/settlement_math.py",
        "must_contain": [
          "def spot_settle",
          "\"spot\""
        ],
        "error": "现货结算口径契约破损: spot_settle 入口或 settlement_basis=\"spot\" 字面量被移除"
      },
      {
        "file": "btc_agent/src/btc_agent/ledger.py",
        "must_contain": [
          "旧版本行及其结算数据只读",
          "get_or_create_strategy_version",
          "params_hash"
        ],
        "error": "账本版本只读契约破损: 策略版本只读不变式说明或 get_or_create_strategy_version/params_hash 被移除"
      },
      {
        "file": "btc_agent/src/btc_agent/candidates.py",
        "must_contain": [
          "CANDIDATE_PARAMS",
          "from btc_agent.agents.schemas import CandidateVerdict"
        ],
        "error": "候选引擎契约破损: 策略版本参数字典 CANDIDATE_PARAMS 或对 CandidateVerdict 的消费点被移除"
      }
    ]
  },
  "env_consistency": {
    "$comment": "运行所需 key 从环境变量读(不入库)。断言文档/示例里保留这些变量名，避免接手者漏配。",
    "rules": [
      {
        "$comment": "LLM key(中转站/官方)必须始终从 DEEPSEEK_API_KEY 读，run.py 有显式校验。",
        "file": "btc_agent/src/btc_agent/run.py",
        "must_contain": "DEEPSEEK_API_KEY",
        "error": "run.py 丢失 DEEPSEEK_API_KEY 环境变量校验"
      },
      {
        "$comment": "v2 daily 编排入口(python -m btc_agent.daily)同样必须校验 DEEPSEEK_API_KEY，不许绕开 run.py 单独一套校验语义。",
        "file": "btc_agent/src/btc_agent/daily.py",
        "must_contain": "DEEPSEEK_API_KEY",
        "error": "daily.py 丢失 DEEPSEEK_API_KEY 环境变量校验"
      }
    ]
  },
  "project_conventions": {
    "schema_version": 1,
    "profile": "standard",
    "tracker": {
      "kind": "local",
      "remote": null,
      "doc": "docs/agents/issue-tracker.md",
      "publication_policy": "explicit"
    },
    "domain": {
      "layout": "single",
      "doc": "docs/agents/domain.md"
    },
    "triage": {
      "enabled": false,
      "doc": null,
      "labels": null
    },
    "agent_file": "AGENTS.md",
    "integrity": {
      "documents": {
        "docs/agents/issue-tracker.md": "ee4ed8482c275cf15dab1d909d559712ec4686a573e7aab5462a4f9a881ace3f",
        "docs/agents/domain.md": "eca30ed9e1738df80aa68a42c37399b1ee93c6fbfa1878b41c9bfce273ccfa67"
      },
      "agent_block_sha256": "936842c5775852e4ee96a0a09bace118a57dae8325f729122ef3e535c67570a4"
    }
  }
}
